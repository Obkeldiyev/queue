# Path to the Electron EXE inside the win-unpacked directory on the server.
# The entire win-unpacked folder is packaged into the download ZIP, so all
# Electron runtime files (v8_context_snapshot.bin, snapshot_blob.bin, DLLs, etc.)
# are included automatically.
KIOSK_TEMPLATE_PATH=/home/giga/queue/templates/win-unpacked/Qubit QMS Kiosk.exe
