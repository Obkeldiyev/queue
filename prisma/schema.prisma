  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  company    Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  logo_media MediaFile? @relation("TicketLogo", fields: [logo_media_id], references: [id])

  @@index([company_id])
  @@map("ticket_templates")
}

model Ticket {
  id               String       @id @default(uuid()) @db.Uuid
  queue_group_id   String       @db.Uuid
  branch_id        String       @db.Uuid
  counter_id       String?      @db.Uuid
  counter_session_id String?    @db.Uuid
  reservation_id   String?      @db.Uuid @unique
  customer_id      String?      @db.Uuid
  served_by_id     String?      @db.Uuid
  ticket_number    String       @db.VarChar(30)
  status           TicketStatus @default(WAITING)
  priority         Int          @default(0)
  called_at        DateTime?
  serving_started_at DateTime?
  completed_at     DateTime?
  wait_time_sec    Int?
  service_time_sec Int?
  is_online        Boolean      @default(false)
  notes            String?      @db.Text
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  queue_group     QueueGroup       @relation(fields: [queue_group_id], references: [id])
  branch          Branch           @relation(fields: [branch_id], references: [id])
  counter         Counter?         @relation(fields: [counter_id], references: [id])
  counter_session CounterSession?  @relation(fields: [counter_session_id], references: [id])
  reservation     QueueReservation? @relation(fields: [reservation_id], references: [id])
  customer        Customer?        @relation(fields: [customer_id], references: [id])
  served_by       CompanyUser?     @relation("ServedBy", fields: [served_by_id], references: [id])
  history         TicketHistory[]
  order           Order?

  @@index([queue_group_id])
  @@index([branch_id])
  @@index([status])
  @@index([ticket_number])
  @@map("tickets")
}

model TicketHistory {
  id           String       @id @default(uuid()) @db.Uuid
  ticket_id    String       @db.Uuid
  from_status  TicketStatus?
  to_status    TicketStatus
  changed_by   String?      @db.Uuid
  changed_type String?      @db.VarChar(30)
  note         String?      @db.Text
  created_at   DateTime     @default(now())

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@map("ticket_history")
}

model QueueReservation {
  id               String            @id @default(uuid()) @db.Uuid
  customer_id      String            @db.Uuid
  queue_group_id   String            @db.Uuid
  branch_id        String            @db.Uuid
  reservation_time DateTime
  arrival_deadline DateTime
  arrival_method   String?           @db.VarChar(30) // "QR" | "GPS" | "PIN" | "KIOSK"
  confirmed_at     DateTime?
