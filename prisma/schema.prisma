  updated_at       DateTime          @updatedAt

  customer    Customer   @relation(fields: [customer_id], references: [id])
  queue_group QueueGroup @relation(fields: [queue_group_id], references: [id])
  branch      Branch     @relation(fields: [branch_id], references: [id])
  ticket      Ticket?

  @@index([customer_id])
  @@index([queue_group_id])
  @@map("queue_reservations")
}

model QrCode {
