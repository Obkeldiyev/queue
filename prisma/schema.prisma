model AuditLog {
  id                    String      @id @default(uuid()) @db.Uuid
  company_id            String?     @db.Uuid
  // Polymorphic actor: only one of these two will be set
  platform_user_id      String?     @db.Uuid
  company_user_id       String?     @db.Uuid
  actor_type            String?     @db.VarChar(30) // "platform_user" | "company_user" | "system"
  action                AuditAction
  entity_type           String?     @db.VarChar(80)
  entity_id             String?     @db.Uuid
  branch_id             String?     @db.Uuid
  ip_address            String?     @db.VarChar(50)
  user_agent            String?     @db.VarChar(500)
  before_state          Json?
  after_state           Json?
  metadata              Json?
  created_at            DateTime    @default(now())

  company       Company?      @relation(fields: [company_id], references: [id])
  platform_user PlatformUser? @relation("PlatformUserAuditLogs", fields: [platform_user_id], references: [id])
  company_user  CompanyUser?  @relation("CompanyUserAuditLogs", fields: [company_user_id], references: [id])

  @@index([company_id])
  @@index([platform_user_id])
  @@index([company_user_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}
