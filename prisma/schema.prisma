datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  LOGO
  BANNER
  THUMBNAIL
  ICON
}

enum DeviceType {
  TICKET_KIOSK
  TICKET_PRINTER
  QUEUE_DISPLAY
  COUNTER_DISPLAY
  OPERATOR_KEYBOARD
  QR_SCANNER
  MEDIA_DISPLAY
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  UNREGISTERED
}

enum QueueType {
  SEQUENTIAL
  PRIORITY
  SMART
  APPOINTMENT
}

enum TicketStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  NO_SHOW
  TRANSFERRED
}

enum QrCodeType {
  QUEUE
  ORDER
  CHECK_IN
  PAGE
  PROMOTION
  PAYMENT
  DEVICE
}

enum QrTargetType {
  TICKET
  ORDER
  PAGE
  BRANCH
  PRODUCT
  SERVICE
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ComponentType {
  TEXT
  HEADING
  IMAGE
  VIDEO
  BUTTON
  FORM
  MAP
  QUEUE_BUTTON
  ORDER_BUTTON
  PRODUCT_GRID
  FAQ
  CAROUSEL
  BANNER
  HTML
  QR_BLOCK
  CONTACT_BLOCK
  DIVIDER
  SPACER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
  PAYME
  UZUM
  STRIPE
  PAYPAL
  TELEGRAM_PAY
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum RoleType {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  BRANCH_MANAGER
  SUPERVISOR
  OPERATOR
  CONTENT_MANAGER
  VIEWER
  CUSTOM
}

enum AdvertisementStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  EXPIRED
  CANCELLED
  NO_SHOW
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CALL_NEXT
  COMPLETE_SERVICE
  TRANSFER
  PRINT_TICKET
  SCAN_QR
  DEVICE_CONNECT
  DEVICE_DISCONNECT
  PAYMENT
  REFUND
  PUBLISH_PAGE
  TOGGLE_STATUS
}

model Subscription {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String               @db.VarChar(120)
  description           String?              @db.Text
  monthly_price         Decimal              @db.Decimal(12, 2)
  yearly_price          Decimal              @db.Decimal(12, 2)
  max_branches          Int                  @default(1)
  max_users             Int                  @default(5)
  max_devices           Int                  @default(10)
  max_storage_gb        Int                  @default(5)
  online_queue_enabled  Boolean              @default(false)
  ordering_enabled      Boolean              @default(false)
  analytics_enabled     Boolean              @default(false)
  custom_domain_enabled Boolean              @default(false)
  api_access_enabled    Boolean              @default(false)
  is_active             Boolean              @default(true)
  sort_order            Int                  @default(0)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt

  company_subscriptions CompanySubscription[]

  @@map("subscriptions")
}

model CompanySubscription {
  id              String             @id @default(uuid()) @db.Uuid
  company_id      String             @db.Uuid
  subscription_id String             @db.Uuid
  started_at      DateTime           @default(now())
  expires_at      DateTime
  status          SubscriptionStatus @default(ACTIVE)
  payment_method  PaymentMethod?
  amount_paid     Decimal?           @db.Decimal(12, 2)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  company      Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscription_id], references: [id])

  @@index([company_id])
  @@index([status])
  @@map("company_subscriptions")
}

model PlatformUser {
  id            String       @id @default(uuid()) @db.Uuid
  first_name    String       @db.VarChar(80)
  last_name     String       @db.VarChar(80)
  email         String       @unique @db.VarChar(200)
  password_hash String       @db.VarChar(255)
  status        UserStatus   @default(ACTIVE)
  last_login_at DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  roles         PlatformUserRole[]
  audit_logs    AuditLog[]         @relation("PlatformUserAuditLogs")

  @@index([email])
  @@map("platform_users")
}

model PlatformRole {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique @db.VarChar(80)
  description String?            @db.Text
  created_at  DateTime           @default(now())

  users       PlatformUserRole[]
  permissions PlatformRolePermission[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(100)
  name        String @db.VarChar(120)
  description String? @db.Text
  module      String @db.VarChar(80)

  roles PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformUserRole {
  platform_user_id String @db.Uuid
  platform_role_id String @db.Uuid

  platform_user PlatformUser @relation(fields: [platform_user_id], references: [id], onDelete: Cascade)
  platform_role PlatformRole @relation(fields: [platform_role_id], references: [id], onDelete: Cascade)

  @@id([platform_user_id, platform_role_id])
  @@map("platform_user_roles")
}

model PlatformRolePermission {
  platform_role_id       String @db.Uuid
  platform_permission_id String @db.Uuid

  platform_role       PlatformRole       @relation(fields: [platform_role_id], references: [id], onDelete: Cascade)
  platform_permission PlatformPermission @relation(fields: [platform_permission_id], references: [id], onDelete: Cascade)

  @@id([platform_role_id, platform_permission_id])
  @@map("platform_role_permissions")
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(120)
  logo_media_id    String?       @db.Uuid
  primary_color    String?       @db.VarChar(10)
  secondary_color  String?       @db.VarChar(10)
  phone            String?       @db.VarChar(30)
  email            String?       @db.VarChar(200)
  website          String?       @db.VarChar(255)
  address          String?       @db.Text
  timezone         String        @default("Asia/Tashkent") @db.VarChar(60)
  locale           String        @default("uz") @db.VarChar(10)
  settings         Json?         // Company-level visual/content settings (kiosk/display)
  status           CompanyStatus @default(TRIAL)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  logo_media            MediaFile?            @relation("CompanyLogo", fields: [logo_media_id], references: [id])
  branches              Branch[]
  users                 CompanyUser[]
  roles                 CompanyRole[]
  media_files           MediaFile[]           @relation("CompanyMedia")
  themes                Theme[]
  pages                 Page[]
  menus                 Menu[]
  services              Service[]
  queue_groups          QueueGroup[]
  counters              Counter[]
  devices               Device[]
  qr_codes              QrCode[]
  customers             Customer[]
  products              Product[]
  product_categories    ProductCategory[]
  orders                Order[]
  order_stages          OrderStage[]
  notification_templates NotificationTemplate[]
  advertisements        Advertisement[]
  company_subscriptions CompanySubscription[]
  ticket_templates      TicketTemplate[]
  audit_logs            AuditLog[]
  analytics_snapshots   AnalyticsSnapshot[]
  surveys               Survey[]

  @@index([slug])
  @@index([status])
  @@map("companies")
}

model CompanyUser {
  id            String     @id @default(uuid()) @db.Uuid
  company_id    String     @db.Uuid
  branch_id     String?    @db.Uuid
  default_counter_id String? @db.Uuid
  first_name    String     @db.VarChar(80)
  last_name     String     @db.VarChar(80)
  email         String     @db.VarChar(200)
  phone         String?    @db.VarChar(30)
  allowed_service_ids Json?
  password_hash String     @db.VarChar(255)
  avatar_url    String?    @db.VarChar(500)
  status        UserStatus @default(ACTIVE)
  last_login_at DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  company  Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branch_id], references: [id])
  // `default_counter_id` stores the admin-assigned counter UUID. Relation intentionally omitted
  // to avoid adding a back-reference field on `Counter`.
  roles    CompanyUserRole[]
  counter_sessions CounterSession[]
  audit_logs       AuditLog[]         @relation("CompanyUserAuditLogs")
  served_tickets   Ticket[]           @relation("ServedBy")
  created_pages    PageVersion[]

  @@unique([company_id, email])
  @@index([email])
  @@index([company_id])
  @@index([branch_id])
  @@map("company_users")
}

model CompanyRole {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  name        String   @db.VarChar(80)
  type        RoleType @default(CUSTOM)
  description String?  @db.Text
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())

  company     Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users       CompanyUserRole[]
  permissions CompanyRolePermission[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("company_roles")
}

model CompanyPermission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(100)
  name        String @db.VarChar(120)
  description String? @db.Text
  module      String @db.VarChar(80)

  roles CompanyRolePermission[]

  @@map("company_permissions")
}

model CompanyUserRole {
  company_user_id String @db.Uuid
  company_role_id String @db.Uuid

  company_user CompanyUser @relation(fields: [company_user_id], references: [id], onDelete: Cascade)
  company_role CompanyRole @relation(fields: [company_role_id], references: [id], onDelete: Cascade)

  @@id([company_user_id, company_role_id])
  @@map("company_user_roles")
}

model CompanyRolePermission {
  company_role_id       String @db.Uuid
  company_permission_id String @db.Uuid

  company_role       CompanyRole       @relation(fields: [company_role_id], references: [id], onDelete: Cascade)
  company_permission CompanyPermission @relation(fields: [company_permission_id], references: [id], onDelete: Cascade)

  @@id([company_role_id, company_permission_id])
  @@map("company_role_permissions")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  user_type  String   @db.VarChar(30) // "platform_user" | "company_user" | "customer"
  token_hash String   @unique @db.VarChar(255)
  ip_address String?  @db.VarChar(50)
  user_agent String?  @db.VarChar(500)
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id, user_type])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model Branch {
  id            String      @id @default(uuid()) @db.Uuid
  company_id    String      @db.Uuid
  name_uz       String      @db.VarChar(200)
  name_ru       String?     @db.VarChar(200)
  name_en       String?     @db.VarChar(200)
  phone         String?     @db.VarChar(30)
  email         String?     @db.VarChar(200)
  address_uz    String?     @db.Text
  address_ru    String?     @db.Text
  address_en    String?     @db.Text
  latitude      Decimal?    @db.Decimal(10, 8)
  longitude     Decimal?    @db.Decimal(11, 8)
  working_hours Json?       // { mon: {open:"09:00", close:"18:00"}, ... }
  timezone      String?     @db.VarChar(60)
  status        BranchStatus @default(ACTIVE)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  company        Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users          CompanyUser[]
  queue_groups   QueueGroup[]
  counters       Counter[]
  devices        Device[]
  qr_codes       QrCode[]
  orders         Order[]
  tickets        Ticket[]
  reservations   QueueReservation[]
  analytics      AnalyticsSnapshot[]
  advertisements BranchAdvertisement[]
  surveys        BranchSurvey[]

  @@index([company_id])
  @@map("branches")
}

model MediaFile {
  id               String    @id @default(uuid()) @db.Uuid
  company_id       String    @db.Uuid
  uploaded_by_id   String?   @db.Uuid
  uploaded_by_type String?   @db.VarChar(30) // "platform_user" | "company_user"
  type             MediaType
  mime_type        String    @db.VarChar(120)
  filename         String    @db.VarChar(255)
  original_name    String    @db.VarChar(255)
  size_bytes       BigInt
  path             String    @db.VarChar(500)
  cdn_url          String?   @db.VarChar(500)
  thumbnail_url    String?   @db.VarChar(500)
  duration_seconds Int?
  width            Int?
  height           Int?
  alt_text         String?   @db.VarChar(255)
  metadata         Json?
  is_public        Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  company Company @relation("CompanyMedia", fields: [company_id], references: [id], onDelete: Cascade)

  company_logos         Company[]           @relation("CompanyLogo")
  theme_logos           Theme[]             @relation("ThemeLogo")
  theme_favicons        Theme[]             @relation("ThemeFavicon")
  page_components       PageComponent[]     @relation("ComponentMedia")
  product_images        Product[]           @relation("ProductImage")
  product_category_images ProductCategory[] @relation("CategoryImage")
  advertisement_media   Advertisement[]     @relation("AdMedia")
  customer_avatars      Customer[]          @relation("CustomerAvatar")
  qr_code_images        QrCode[]            @relation("QrImage")
  menu_icons            Menu[]              @relation("MenuIcon")
  service_icons         Service[]           @relation("ServiceIcon")
  ticket_template_logos TicketTemplate[]    @relation("TicketLogo")

  @@index([company_id])
  @@index([type])
  @@map("media_files")
}

model Theme {
  id                String   @id @default(uuid()) @db.Uuid
  company_id        String   @db.Uuid
  name              String   @db.VarChar(120)
  primary_color     String?  @db.VarChar(10)
  secondary_color   String?  @db.VarChar(10)
  accent_color      String?  @db.VarChar(10)
  background_color  String?  @db.VarChar(10)
  text_color        String?  @db.VarChar(10)
  font_family       String?  @db.VarChar(80)
  border_radius     String?  @db.VarChar(20)
  logo_media_id     String?  @db.Uuid
  favicon_media_id  String?  @db.Uuid
  custom_css        String?  @db.Text
  is_active         Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  company        Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  logo_media     MediaFile? @relation("ThemeLogo", fields: [logo_media_id], references: [id])
  favicon_media  MediaFile? @relation("ThemeFavicon", fields: [favicon_media_id], references: [id])

  @@index([company_id])
  @@map("themes")
}

model Page {
  id              String     @id @default(uuid()) @db.Uuid
  company_id      String     @db.Uuid
  name            String     @db.VarChar(200)
  slug            String     @db.VarChar(200)
  title           String?    @db.VarChar(255)
  description     String?    @db.Text
  seo_title       String?    @db.VarChar(255)
  seo_description String?    @db.Text
  status          PageStatus @default(DRAFT)
  is_homepage     Boolean    @default(false)
  template        String?    @db.VarChar(80) // "bank", "clinic", "restaurant" etc.
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  company  Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  versions PageVersion[]
  menus    Menu[]

  @@unique([company_id, slug])
  @@index([company_id])
  @@map("pages")
}

model PageVersion {
  id          String   @id @default(uuid()) @db.Uuid
  page_id     String   @db.Uuid
  version     Int      @default(1)
  published   Boolean  @default(false)
  created_by  String?  @db.Uuid
  snapshot    Json?    // Full layout snapshot for rollback
  created_at  DateTime @default(now())

  page        Page          @relation(fields: [page_id], references: [id], onDelete: Cascade)
  created_by_user CompanyUser? @relation(fields: [created_by], references: [id])
  components  PageComponent[]

  @@index([page_id])
  @@map("page_versions")
}

model PageComponent {
  id                  String        @id @default(uuid()) @db.Uuid
  page_version_id     String        @db.Uuid
  component_type      ComponentType
  parent_component_id String?       @db.Uuid
  x_position          Float         @default(0)
  y_position          Float         @default(0)
  width               Float         @default(100)  // percentage
  height              Float?
  sort_order          Int           @default(0)
  // Drag-and-drop layout state
  col_span            Int           @default(12)   // 12-column grid
  row_span            Int           @default(1)
  is_locked           Boolean       @default(false)
  is_hidden           Boolean       @default(false)
  settings            Json?         // All visual/content config
  styles              Json?         // Inline styles object
  mobile_styles       Json?         // Responsive overrides
  animations          Json?         // Entrance/hover animations
  media_id            String?       @db.Uuid
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  page_version     PageVersion    @relation(fields: [page_version_id], references: [id], onDelete: Cascade)
  parent_component PageComponent? @relation("ComponentChildren", fields: [parent_component_id], references: [id])
  children         PageComponent[] @relation("ComponentChildren")
  media            MediaFile?     @relation("ComponentMedia", fields: [media_id], references: [id])

  @@index([page_version_id])
  @@index([parent_component_id])
  @@map("page_components")
}

model Menu {
  id             String   @id @default(uuid()) @db.Uuid
  company_id     String   @db.Uuid
  parent_id      String?  @db.Uuid
  name           String   @db.VarChar(120)
  label          String?  @db.VarChar(120) // Display label (translatable)
  icon_media_id  String?  @db.Uuid
  icon_class     String?  @db.VarChar(80)  // e.g. "home-icon"
  url            String?  @db.VarChar(500)
  page_id        String?  @db.Uuid
  queue_group_id String?  @db.Uuid
  target         String?  @db.VarChar(20)  // "_blank" | "_self"
  sort_order     Int      @default(0)
  is_visible     Boolean  @default(true)
  requires_auth  Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  company    Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  parent     Menu?      @relation("MenuChildren", fields: [parent_id], references: [id])
  children   Menu[]     @relation("MenuChildren")
  page       Page?      @relation(fields: [page_id], references: [id])
  queue_group QueueGroup? @relation(fields: [queue_group_id], references: [id])
  icon_media MediaFile? @relation("MenuIcon", fields: [icon_media_id], references: [id])

  @@index([company_id])
  @@index([parent_id])
  @@map("menus")
}

model Service {
  id                    String        @id @default(uuid()) @db.Uuid
  company_id            String        @db.Uuid
  name_uz               String        @db.VarChar(200)
  name_ru               String?       @db.VarChar(200)
  name_en               String?       @db.VarChar(200)
  description_uz        String?       @db.Text
  description_ru        String?       @db.Text
  description_en        String?       @db.Text
  icon_media_id         String?       @db.Uuid
  color                 String?       @db.VarChar(10)
  estimated_time_mins   Int?
  working_hours         Json?
  priority_level        Int           @default(0)
  status                ServiceStatus @default(ACTIVE)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  company      Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  icon_media   MediaFile?   @relation("ServiceIcon", fields: [icon_media_id], references: [id])
  queue_groups QueueGroup[]

  @@index([company_id])
  @@map("services")
}

model QueueGroup {
  id                    String    @id @default(uuid()) @db.Uuid
  company_id            String    @db.Uuid
  branch_id             String    @db.Uuid
  service_id            String?   @db.Uuid
  name_uz               String    @db.VarChar(200)
  name_ru               String?   @db.VarChar(200)
  name_en               String?   @db.VarChar(200)
  prefix                String    @db.VarChar(10)
  // Number format: "PREFIX-{NUM:4}" or "{BRANCH}-{PREFIX}-{NUM:3}"
  number_format         String    @default("{PREFIX}{NUM:3}") @db.VarChar(80)
  queue_type            QueueType @default(SEQUENTIAL)
  daily_limit           Int?
  daily_reset_time      String?   @db.VarChar(10)  // "00:00"
  current_number        Int       @default(0)
  priority_weight       Int       @default(0)
  online_enabled        Boolean   @default(false)
  auto_recall_enabled   Boolean   @default(false)
  auto_recall_after_sec Int       @default(30)
  no_show_after_sec     Int       @default(300)
  working_hours         Json?
  is_active             Boolean   @default(true)
  sort_order            Int       @default(0)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  company      Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  service      Service?         @relation(fields: [service_id], references: [id])
  counter_queues CounterQueue[]
  tickets       Ticket[]
  reservations  QueueReservation[]
  menus         Menu[]

  @@index([company_id])
  @@index([branch_id])
  @@map("queue_groups")
}

model Counter {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  branch_id   String   @db.Uuid
  name_uz     String   @db.VarChar(100)
  name_ru     String?  @db.VarChar(100)
  name_en     String?  @db.VarChar(100)
  number      Int
  description String?  @db.VarChar(255)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company        Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch         Branch           @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  queue_groups   CounterQueue[]
  sessions       CounterSession[]
  tickets        Ticket[]
  devices        Device[]

  @@unique([branch_id, number])
  @@index([company_id])
  @@index([branch_id])
  @@map("counters")
}

model CounterQueue {
  counter_id     String @db.Uuid
  queue_group_id String @db.Uuid
  sort_order     Int    @default(0)

  counter     Counter    @relation(fields: [counter_id], references: [id], onDelete: Cascade)
  queue_group QueueGroup @relation(fields: [queue_group_id], references: [id], onDelete: Cascade)

