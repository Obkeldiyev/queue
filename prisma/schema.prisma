  gateway        String?       @db.VarChar(50)
  payload        Json?
  paid_at        DateTime?
  created_at     DateTime      @default(now())

  order Order @relation(fields: [order_id], references: [id])

  @@index([order_id])
  @@map("payments")
}

model Device {
